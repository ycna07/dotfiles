// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "colorize_brackets": true,
  "indent_guides": {
    "active_line_width": 6,
    "line_width": 3,
    "background_coloring": "disabled",
    "coloring": "indent_aware"
  },
  "prettier": {
    "allowed": false
  },
  "title_bar": {
    "show": false,
    "show_menus": false,
  },
  "node": {
    "allow_binary_download": false,
    "allow_prettier_download": false,
    "allow_npm_install": false,
  },
  "restore_on_startup": "last_workspace",
  "soft_wrap": "editor_width",
  "tabs": {
    "git_status": false,
    "file_icons": true,
  },
  "tab_bar": {
    "show": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "file_icons": true,
    "folder_icons": true,
  },
  "ui_font_family": ".GramSans",
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Gram (Default)",
  },
  "terminal": {
    "shell": {
      "program": "/bin/fish"
    },
    "font_size": 15.0,
    "font_family": "Maple Mono",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "autosave": "on_focus_change",
  "buffer_font_family": "Maple Mono",
  "vim_mode": true,
  "base_keymap": "Minimal",
  "ui_font_size": 17.0,
  "buffer_font_size": 24.0,
  "theme": {
    "mode": "light",
    "light": "Catppuccin Latte",
    "dark": "Dracula",
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "deno",
        "!vtsls",
        "!eslint"
      ]
    }
  },
  "lsp": {
    "superhtml": {
      "binary": {
        "ignore_system_version": false,
        "enable_auto_updates": false,
        "allow_binary_download": false
      },
      "enable_lsp_tasks": true
    },
    "yaml-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "glasgow": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "tailwindcss-language-server": {
      "binary": {
        "allow_binary_download": false,
        "ignore_system_version": false,
        "enable_auto_updates": false,
      },
      "enable_lsp_tasks": true,
    },
    "eslint": {
      "binary": {
        "enable_auto_updates": false,
        "ignore_system_version": false,
        "allow_binary_download": false,
      },
      "enable_lsp_tasks": true,
    },
    "vtsls": {
      "binary": {
        "enable_auto_updates": false,
        "ignore_system_version": false,
        "allow_binary_download": false,
      },
      "enable_lsp_tasks": true,
    },
    "jdtls": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "tinymist": {
      "initialization_options": {
        // Enable background preview
        // Server will be running on 127.0.0.1:23635
        "preview": {
          "background": {
            "enabled": true,
          },
        },
      },
      "settings": {
        // Compile on save
        // This will compile a PDF for the `main.typ` file in the project root.
        "exportPdf": "onSave",
        "outputPath": "$root/$name",
        // Enable formatter
        "formatterMode": "typstyle",
      },
    },
    "package-version-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "deps-lsp": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "initialization_options": {
        "inlay_hints": {
          "enabled": true,
          "up_to_date_text": "✅",
          "needs_update_text": "❌ {}",
        },
        "diagnostics": {
          "outdated_severity": "hint",
          "unknown_severity": "warning",
        },
        "cache": {
          "enabled": true,
          "refresh_interval_secs": 300,
          "fetch_timeout_secs": 10,
          "max_concurrent_fetches": 20,
        },
        "loading_indicator": {
          "enabled": true,
          "fallback_to_hints": true,
          "loading_text": "...",
        },
        "cold_start": {
          "enabled": true,
          "rate_limit_ms": 100,
        },
      },
    },
  },
}
